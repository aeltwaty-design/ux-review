# Copy to .env.local for local development. The same two values go into Vercel → Project → Environment Variables
# (if you connected the project through Vercel's Supabase integration, its NEXT_PUBLIC_SUPABASE_URL and
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY / NEXT_PUBLIC_SUPABASE_ANON_KEY are picked up automatically — nothing to add).
# Both are PUBLIC values (the anon/publishable key is meant for browsers; row-level security protects the data).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Only for `npm run seed` (never commit, never put in Vercel): the service-role key from Supabase → Settings → API.
# SUPABASE_SERVICE_ROLE_KEY=
