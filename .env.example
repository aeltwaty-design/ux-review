# Copy to .env.local for local development. The same two values go into Vercel → Project → Environment Variables.
# Both are PUBLIC values (the anon key is meant for browsers; row-level security protects the data).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Only for `npm run seed` (never commit, never put in Vercel): the service-role key from Supabase → Settings → API.
# SUPABASE_SERVICE_ROLE_KEY=
